<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Theme.MaterialComponents.BottomSheetDialog"
    android:theme="@style/Theme.MaterialComponents.BottomSheetDialog"
    tools:ignore="MissingConstraints"
    tools:context=".screens.history.dialog.ChoosePeriodFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_20dp"
        android:background="@drawable/period_bottom_background">
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_period"
            android:textColor="#1D1D1B"
            android:fontFamily="@font/mont_bold"
            android:textSize="@dimen/_16sp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/month_3_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintTop_toTopOf="@id/last_3month_check"
            app:layout_constraintBottom_toBottomOf="@id/last_3month_check"/>
        <ImageButton
            android:id="@+id/month_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintTop_toTopOf="@id/last_month_check"
            app:layout_constraintBottom_toBottomOf="@id/last_month_check"/>
        <ImageButton
            android:id="@+id/week_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintTop_toTopOf="@id/last_week_check"
            app:layout_constraintBottom_toBottomOf="@id/last_week_check"/>
        <TextView
            android:id="@+id/last_3_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/for_3_month"
            android:textColor="#535353"
            android:letterSpacing="-0.01"
            android:fontFamily="@font/mont_semibold"
            android:textSize="@dimen/_14sp"
            android:layout_marginTop="@dimen/_20dp"
            app:layout_constraintTop_toBottomOf="@id/title"/>
        <CheckBox
            android:id="@+id/last_3month_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/choose_check"
            android:theme="@style/Theme.AppCompat"
            android:layout_marginTop="@dimen/_20dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:id="@+id/last_3month_view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="#B2B2B2"
            app:layout_constraintTop_toBottomOf="@id/last_3month_check"
            android:layout_marginTop="@dimen/_13dp"/>

        <TextView
            android:id="@+id/last_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/for_month"
            android:textColor="#535353"
            android:letterSpacing="-0.01"
            android:fontFamily="@font/mont_semibold"
            android:textSize="@dimen/_14sp"
            android:layout_marginTop="@dimen/_20dp"
            app:layout_constraintTop_toBottomOf="@id/last_3month_view"/>
        <CheckBox
            android:id="@+id/last_month_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/choose_check"
            android:theme="@style/Theme.AppCompat"
            android:layout_marginTop="@dimen/_20dp"
            app:layout_constraintTop_toBottomOf="@id/last_3month_view"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:id="@+id/last_month_view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="#B2B2B2"
            app:layout_constraintTop_toBottomOf="@id/last_month_check"
            android:layout_marginTop="@dimen/_13dp"/>

        <TextView
            android:id="@+id/last_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/for_week"
            android:textColor="#535353"
            android:letterSpacing="-0.01"
            android:fontFamily="@font/mont_semibold"
            android:textSize="@dimen/_14sp"
            android:layout_marginTop="@dimen/_20dp"
            app:layout_constraintTop_toBottomOf="@id/last_month_view"/>
        <CheckBox
            android:id="@+id/last_week_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/choose_check"
            android:theme="@style/Theme.AppCompat"
            android:layout_marginTop="@dimen/_20dp"
            app:layout_constraintTop_toBottomOf="@id/last_month_view"
            app:layout_constraintEnd_toEndOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37dp"
            android:background="@drawable/start_period_background"
            app:layout_constraintTop_toBottomOf="@id/last_week_check"
            android:layout_marginTop="@dimen/_45dp">
            <ImageButton
                android:id="@+id/choose_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/choose"
                android:textColor="@color/white"
                android:textSize="@dimen/_16sp"
                android:fontFamily="@font/mont_semibold"
                android:gravity="center"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>