<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121012"
    tools:context=".screens.qr.QrFragment">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/full_screen_scanner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:zxing_possible_result_points="@color/white"
        app:zxing_result_view="@android:color/transparent"
        app:zxing_viewfinder_laser="@android:color/transparent"
        app:zxing_viewfinder_mask="@android:color/transparent" />

    <com.esom.bank.common.utils.views.QrScanFrameView
        android:id="@+id/scan_frame"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:layout_marginHorizontal="52dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:fontFamily="@font/mont_bold"
        android:text="@string/qr_screen_title"
        android:textColor="@color/title"
        android:textSize="@dimen/_27sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20dp"
        android:layout_marginTop="@dimen/_6dp"
        android:layout_marginEnd="@dimen/_20dp"
        android:fontFamily="@font/mont_regular"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/_2dp"
        android:text="@string/qr_screen_subtitle"
        android:textColor="@color/subtitle"
        android:textSize="@dimen/_13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/mode_toggle_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:layout_marginEnd="@dimen/_16dp"
        android:elevation="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scan_tab_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/qr_mode_scan"
            android:textAllCaps="false"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/show_tab_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="200dp"
            android:layout_height="@dimen/_48dp"
            android:backgroundTint="#EFFFFFFF"
            android:fontFamily="@font/mont_semibold"
            android:text="Показать QR"
            android:textAllCaps="false"
            android:textColor="#A71924"
            app:cornerRadius="@dimen/_24dp"
            app:icon="@drawable/ic_qr_scan"
            app:iconPadding="@dimen/_8dp"
            app:iconSize="@dimen/_22dp"
            app:iconTint="#A71924"
            app:strokeWidth="0dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="@dimen/_24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/scan_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="0dp"
                app:cardElevation="@dimen/_0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toTopOf="@id/scanner_actions"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/scanner_actions"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_96dp"
                        android:layout_marginBottom="@dimen/_52dp"
                        android:background="@drawable/qr_scanner_actions_background"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                        android:id="@+id/scan_gallery_btn"
                        android:layout_width="@dimen/_100dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView android:layout_width="@dimen/_34dp" android:layout_height="@dimen/_34dp" android:src="@drawable/ic_qr_file" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/_4dp" android:fontFamily="@font/mont_semibold" android:text="Галерея" android:textColor="@color/white" android:textSize="@dimen/_12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/flashlight_btn"
                        android:layout_width="@dimen/_100dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView android:layout_width="@dimen/_34dp" android:layout_height="@dimen/_34dp" android:src="@drawable/ic_qr_flashlight" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/_4dp" android:fontFamily="@font/mont_semibold" android:text="Фонарик" android:textColor="@color/white" android:textSize="@dimen/_12sp" />
                    </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/show_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@drawable/light_atmosphere_background"
                android:minHeight="760dp"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_20dp"
                android:paddingTop="@dimen/_76dp">

                <TextView
                    android:id="@+id/show_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:layout_marginBottom="@dimen/_12dp"
                    android:fontFamily="@font/mont_bold"
                    android:text="@string/qr_show_heading"
                    android:textColor="@color/title"
                    android:textSize="@dimen/_20sp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/phone_qr_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="@dimen/_24dp"
                    app:cardElevation="@dimen/_0dp"
                    app:strokeColor="@color/lock_pattern_regular"
                    app:strokeWidth="@dimen/_1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_16dp">

                        <TextView
                            android:id="@+id/phone_qr_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mont_bold"
                            android:text="@string/qr_phone_title"
                            android:textColor="@color/title"
                            android:textSize="@dimen/_16sp"
                            app:layout_constraintEnd_toStartOf="@id/phone_qr_copy_btn"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/phone_qr_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6dp"
                            android:fontFamily="@font/mont_regular"
                            android:lineSpacingExtra="@dimen/_2dp"
                            android:text="@string/empty_value"
                            android:textColor="@color/subtitle"
                            android:textSize="@dimen/_12sp"
                            app:layout_constraintEnd_toStartOf="@id/phone_qr_image"
                            app:layout_constraintStart_toStartOf="@id/phone_qr_title"
                            app:layout_constraintTop_toBottomOf="@id/phone_qr_title" />

                        <ImageButton
                            android:id="@+id/phone_primary_btn"
                            android:layout_width="@dimen/_40dp"
                            android:layout_height="@dimen/_40dp"
                            android:layout_marginTop="@dimen/_8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Основная валюта"
                            android:padding="@dimen/_8dp"
                            android:src="@drawable/ic_star_selected"
                            app:layout_constraintStart_toStartOf="@id/phone_qr_value"
                            app:layout_constraintTop_toBottomOf="@id/phone_qr_value" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/phone_qr_copy_btn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:paddingHorizontal="@dimen/_6dp"
                            android:text="@string/qr_copy"
                            android:textAllCaps="false"
                            android:textColor="#E62324"
                            app:layout_constraintEnd_toStartOf="@id/phone_qr_share_btn"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/phone_qr_share_btn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:paddingHorizontal="@dimen/_6dp"
                            android:text="@string/share"
                            android:textAllCaps="false"
                            android:textColor="#E62324"
                            app:icon="@drawable/ic_share_success"
                            app:iconPadding="@dimen/_4dp"
                            app:iconTint="#E62324"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/phone_qr_image"
                            android:layout_width="@dimen/_120dp"
                            android:layout_height="@dimen/_120dp"
                            android:layout_marginTop="@dimen/_14dp"
                            android:contentDescription="@string/qr_phone_title"
                            android:scaleType="fitCenter"
                            android:src="@drawable/qr_code"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/phone_qr_copy_btn" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/salam_qr_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="@dimen/_24dp"
                    app:cardElevation="@dimen/_0dp"
                    app:strokeColor="@color/lock_pattern_regular"
                    app:strokeWidth="@dimen/_1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_16dp">

                        <TextView
                            android:id="@+id/salam_qr_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mont_bold"
                            android:text="@string/qr_salam_title"
                            android:textColor="@color/title"
                            android:textSize="@dimen/_16sp"
                            app:layout_constraintEnd_toStartOf="@id/salam_qr_copy_btn"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/salam_qr_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6dp"
                            android:fontFamily="@font/mont_regular"
                            android:lineSpacingExtra="@dimen/_2dp"
                            android:text="@string/empty_value"
                            android:textColor="@color/subtitle"
                            android:textSize="@dimen/_12sp"
                            app:layout_constraintEnd_toStartOf="@id/salam_qr_image"
                            app:layout_constraintStart_toStartOf="@id/salam_qr_title"
                            app:layout_constraintTop_toBottomOf="@id/salam_qr_title" />

                        <ImageButton
                            android:id="@+id/salam_primary_btn"
                            android:layout_width="@dimen/_40dp"
                            android:layout_height="@dimen/_40dp"
                            android:layout_marginTop="@dimen/_8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Сделать основной валютой"
                            android:padding="@dimen/_8dp"
                            android:src="@drawable/ic_star_unselected"
                            app:layout_constraintStart_toStartOf="@id/salam_qr_value"
                            app:layout_constraintTop_toBottomOf="@id/salam_qr_value" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/salam_qr_copy_btn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:paddingHorizontal="@dimen/_6dp"
                            android:text="@string/qr_copy"
                            android:textAllCaps="false"
                            android:textColor="#E62324"
                            app:layout_constraintEnd_toStartOf="@id/salam_qr_share_btn"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/salam_qr_share_btn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:paddingHorizontal="@dimen/_6dp"
                            android:text="@string/share"
                            android:textAllCaps="false"
                            android:textColor="#E62324"
                            app:icon="@drawable/ic_share_success"
                            app:iconPadding="@dimen/_4dp"
                            app:iconTint="#E62324"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/salam_qr_image"
                            android:layout_width="@dimen/_120dp"
                            android:layout_height="@dimen/_120dp"
                            android:layout_marginTop="@dimen/_14dp"
                            android:contentDescription="@string/qr_salam_title"
                            android:scaleType="fitCenter"
                            android:src="@drawable/qr_code"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/salam_qr_copy_btn" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/usdt_qr_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="@dimen/_24dp"
                    app:cardElevation="@dimen/_0dp"
                    app:strokeColor="@color/lock_pattern_regular"
                    app:strokeWidth="@dimen/_1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_16dp">

                        <TextView
                            android:id="@+id/usdt_qr_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mont_bold"
                            android:text="@string/qr_usdt_title"
                            android:textColor="@color/title"
                            android:textSize="@dimen/_16sp"
                            app:layout_constraintEnd_toStartOf="@id/usdt_qr_copy_btn"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/usdt_qr_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6dp"
                            android:fontFamily="@font/mont_regular"
                            android:lineSpacingExtra="@dimen/_2dp"
                            android:text="@string/empty_value"
                            android:textColor="@color/subtitle"
                            android:textSize="@dimen/_12sp"
                            app:layout_constraintEnd_toStartOf="@id/usdt_qr_image"
                            app:layout_constraintStart_toStartOf="@id/usdt_qr_title"
                            app:layout_constraintTop_toBottomOf="@id/usdt_qr_title" />

                        <ImageButton
                            android:id="@+id/usdt_primary_btn"
                            android:layout_width="@dimen/_40dp"
                            android:layout_height="@dimen/_40dp"
                            android:layout_marginTop="@dimen/_8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Сделать основной валютой"
                            android:padding="@dimen/_8dp"
                            android:src="@drawable/ic_star_unselected"
                            app:layout_constraintStart_toStartOf="@id/usdt_qr_value"
                            app:layout_constraintTop_toBottomOf="@id/usdt_qr_value" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/usdt_qr_copy_btn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:paddingHorizontal="@dimen/_6dp"
                            android:text="@string/qr_copy"
                            android:textAllCaps="false"
                            android:textColor="#E62324"
                            app:layout_constraintEnd_toStartOf="@id/usdt_qr_share_btn"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/usdt_qr_share_btn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:paddingHorizontal="@dimen/_6dp"
                            android:text="@string/share"
                            android:textAllCaps="false"
                            android:textColor="#E62324"
                            app:icon="@drawable/ic_share_success"
                            app:iconPadding="@dimen/_4dp"
                            app:iconTint="#E62324"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/usdt_qr_image"
                            android:layout_width="@dimen/_120dp"
                            android:layout_height="@dimen/_120dp"
                            android:layout_marginTop="@dimen/_14dp"
                            android:contentDescription="@string/qr_usdt_title"
                            android:scaleType="fitCenter"
                            android:src="@drawable/qr_code"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/usdt_qr_copy_btn" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

