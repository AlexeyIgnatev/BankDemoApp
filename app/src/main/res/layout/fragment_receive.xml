<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:ignore="MissingConstraints"
    tools:context=".screens.receive.ReceiveFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/back_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10dp"
        android:padding="@dimen/_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/back_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4dp"
            android:fontFamily="@font/mont_bold"
            android:text="@string/back"
            android:textColor="#E62324"
            android:textSize="@dimen/_12sp"
            app:layout_constraintBottom_toBottomOf="@id/back_icon"
            app:layout_constraintStart_toEndOf="@id/back_icon"
            app:layout_constraintTop_toTopOf="@id/back_icon" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/back_btn"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="@id/back_layout"
        app:layout_constraintEnd_toEndOf="@id/back_layout"
        app:layout_constraintStart_toStartOf="@id/back_layout"
        app:layout_constraintTop_toTopOf="@id/back_layout" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:fontFamily="@font/mont_bold"
        android:text="@string/receive"
        android:textColor="#1D1D1B"
        android:textSize="@dimen/_27sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/data_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_145dp"
        android:padding="@dimen/_10dp"
        android:layout_marginHorizontal="@dimen/_12dp"
        android:background="@drawable/receiving_background"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:layout_marginTop="@dimen/_18dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/conversation_gray_background"/>

        <TextView
            android:id="@+id/opinion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/receiving_opinion"
            android:fontFamily="@font/mont_semibold"
            android:textColor="#B2B2B2"
            android:textSize="@dimen/_14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            android:layout_marginTop="@dimen/_16dp"/>
        <TextView
            android:id="@+id/contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+996000000"
            android:textColor="#1D1D1B"
            android:fontFamily="@font/mont_semibold"
            android:letterSpacing="-0.01"
            android:textSize="@dimen/_17sp"
            app:layout_constraintTop_toBottomOf="@id/opinion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="@dimen/_16dp"
            android:layout_marginTop="@dimen/_10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/copy_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_38dp"
        android:background="@drawable/copy_background"
        app:layout_constraintTop_toBottomOf="@id/data_layout"
        android:layout_marginHorizontal="@dimen/_20dp"
        android:layout_marginTop="@dimen/_10dp">
        <ImageButton
            android:id="@+id/copy_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView
            android:id="@+id/copy_opinion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/copy_number_phone"
            android:textSize="@dimen/_16sp"
            android:textColor="@color/white"
            android:fontFamily="@font/mont_semibold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/share_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_38dp"
        android:background="@drawable/copy_background"
        app:layout_constraintTop_toBottomOf="@id/copy_layout"
        android:layout_marginHorizontal="@dimen/_20dp"
        android:layout_marginTop="@dimen/_10dp">
        <ImageButton
            android:id="@+id/share_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView
            android:id="@+id/share_opinion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/share"
            android:textSize="@dimen/_16sp"
            android:textColor="@color/white"
            android:fontFamily="@font/mont_semibold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_390dp"
        android:src="@drawable/receive"
        android:scaleType="centerCrop"
        android:layout_marginBottom="-5dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_365dp"
        android:background="@drawable/qr_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="@dimen/_10dp"
        app:layout_constraintTop_toBottomOf="@id/share_layout"
        android:layout_marginTop="@dimen/_20dp">
        <ImageView
            android:id="@+id/qr_icon"
            android:layout_width="@dimen/_220dp"
            android:layout_height="@dimen/_220dp"
            android:scaleType="centerCrop"
            android:src="@drawable/qr_code"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/_55dp"/>
        <ImageView
            android:id="@+id/qr_background"
            android:layout_width="@dimen/_220dp"
            android:layout_height="@dimen/_220dp"
            android:src="@drawable/qr_code_red_background"
            app:layout_constraintTop_toTopOf="@id/qr_icon"
            app:layout_constraintBottom_toBottomOf="@id/qr_icon"
            app:layout_constraintStart_toStartOf="@id/qr_icon"
            app:layout_constraintEnd_toEndOf="@id/qr_icon"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_qr"
            android:textSize="@dimen/_22sp"
            android:fontFamily="@font/mont_medium"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/qr_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_20dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
