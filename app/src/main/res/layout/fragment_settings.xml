<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B090C"
    tools:context=".screens.settigns.SettingsFragment">

    <ImageView
        android:id="@+id/gradient_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/light_atmosphere_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="@dimen/_68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_32dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hero_avatar"
                android:layout_width="@dimen/_104dp"
                android:layout_height="@dimen/_104dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_4dp"
                app:cardBackgroundColor="#FF263B"
                app:cardCornerRadius="@dimen/_34dp"
                app:cardElevation="@dimen/_8dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="@dimen/_1dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_20dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/profile_icon"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/fio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:fontFamily="@font/mont_bold"
                android:gravity="center"
                android:textColor="@color/title"
                android:textSize="@dimen/_27sp"
                tools:text="Богдан" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16dp"
                android:layout_marginTop="@dimen/_28dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/_22dp"
                app:cardElevation="@dimen/_0dp"
                app:strokeWidth="@dimen/_0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mont_bold"
                        android:text="Контактные данные"
                        android:textColor="@color/title"
                        android:textSize="@dimen/_18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_15dp"
                        android:fontFamily="@font/mont_regular"
                        android:text="Номер телефона"
                        android:textColor="@color/subtitle"
                        android:textSize="@dimen/_11sp" />
                    <TextView
                        android:id="@+id/phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3dp"
                        android:fontFamily="@font/mont_semibold"
                        android:textColor="@color/title"
                        android:textSize="@dimen/_16sp"
                        tools:text="+996 (555) 123-123" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="@dimen/_13dp" android:background="@color/lock_pattern_regular" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mont_regular"
                        android:text="Электронная почта"
                        android:textColor="@color/subtitle"
                        android:textSize="@dimen/_11sp" />
                    <TextView
                        android:id="@+id/mail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3dp"
                        android:fontFamily="@font/mont_semibold"
                        android:textColor="@color/title"
                        android:textSize="@dimen/_16sp"
                        tools:text="user@fcb.kg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/call_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_72dp"
                android:layout_marginHorizontal="@dimen/_16dp"
                android:layout_marginTop="@dimen/_12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#E62324"
                app:cardCornerRadius="@dimen/_22dp"
                app:cardElevation="@dimen/_0dp"
                app:strokeWidth="@dimen/_0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/_18dp">
                    <ImageView android:layout_width="@dimen/_28dp" android:layout_height="@dimen/_28dp" android:src="@drawable/call_icon_shadow" app:tint="@color/white" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/_14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/mont_bold" android:text="Персональный менеджер" android:textColor="@color/white" android:textSize="@dimen/_16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/_2dp" android:fontFamily="@font/mont_regular" android:text="Позвонить прямо сейчас" android:textColor="#CCFFFFFF" android:textSize="@dimen/_11sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="@dimen/_18dp" android:layout_height="@dimen/_18dp" android:rotation="-90" android:src="@drawable/arrow_bottom" app:tint="@color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_20dp"
                android:layout_marginTop="@dimen/_28dp"
                android:fontFamily="@font/mont_bold"
                android:text="Услуги"
                android:textColor="@color/title"
                android:textSize="@dimen/_23sp" />

            <LinearLayout
                android:id="@+id/services_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16dp"
                android:paddingTop="@dimen/_10dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/header_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/light_atmosphere_background"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_68dp"
        android:background="@android:color/transparent"
        android:paddingHorizontal="@dimen/_12dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="@dimen/_48dp"
            android:layout_height="@dimen/_48dp"
            android:padding="@dimen/_12dp"
            android:src="@drawable/arrow_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#9F1922" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/compact_avatar"
            android:layout_width="@dimen/_42dp"
            android:layout_height="@dimen/_42dp"
            android:layout_marginStart="@dimen/_4dp"
            android:alpha="0"
            app:cardBackgroundColor="#FF263B"
            app:cardCornerRadius="@dimen/_14dp"
            app:cardElevation="@dimen/_0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/back_btn"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="@dimen/_9dp" android:src="@drawable/profile_icon" app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:id="@+id/compact_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10dp"
            android:alpha="0"
            android:ellipsize="end"
            android:fontFamily="@font/mont_bold"
            android:maxLines="1"
            android:textColor="@color/title"
            android:textSize="@dimen/_18sp"
            app:layout_constraintEnd_toStartOf="@id/settings_btn"
            app:layout_constraintStart_toEndOf="@id/compact_avatar"
            app:layout_constraintTop_toTopOf="@id/compact_avatar"
            app:layout_constraintBottom_toBottomOf="@id/compact_avatar"
            tools:text="Богдан" />
        <ImageView
            android:id="@+id/settings_btn"
            android:layout_width="@dimen/_44dp"
            android:layout_height="@dimen/_44dp"
            android:padding="@dimen/_7dp"
            android:src="@drawable/ic_settings_gear"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#9F1922" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
