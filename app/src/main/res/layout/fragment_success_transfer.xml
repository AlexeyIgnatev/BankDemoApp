<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_250dp"
    android:background="@drawable/fail_success_background"
    tools:ignore="MissingConstraints"
    tools:context=".screens.transfer.dialog.SuccessTransferFragment">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/_115dp"
        android:layout_height="@dimen/_115dp"
        android:src="@drawable/success_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_14dp"/>

    <TextView
        android:id="@+id/success_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/success"
        android:textColor="#535353"
        android:textSize="@dimen/_36sp"
        android:fontFamily="@font/mont_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/icon"
        android:layout_marginTop="@dimen/_3dp"/>
    <TextView
        android:id="@+id/opinion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trans_complete"
        android:textSize="@dimen/_16sp"
        android:textColor="#808080"
        android:fontFamily="@font/mont_regular"
        app:layout_constraintTop_toBottomOf="@id/success_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>