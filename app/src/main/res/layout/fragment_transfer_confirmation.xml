<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Theme.MaterialComponents.BottomSheetDialog"
    android:theme="@style/Theme.MaterialComponents.BottomSheetDialog">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/period_bottom_background"
        android:padding="@dimen/_20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mont_bold"
            android:gravity="center"
            android:text="Подтверждение перевода"
            android:textColor="@color/title"
            android:textSize="@dimen/_20sp"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/details_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18dp"
            app:cardBackgroundColor="#F7F7F7"
            app:cardCornerRadius="@dimen/_16dp"
            app:cardElevation="@dimen/_0dp"
            app:layout_constraintTop_toBottomOf="@id/title">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mont_semibold"
                    android:text="Получатель"
                    android:textColor="#777777"
                    android:textSize="@dimen/_13sp" />

                <TextView
                    android:id="@+id/recipient_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:fontFamily="@font/mont_bold"
                    android:text="-"
                    android:textColor="@color/title"
                    android:textSize="@dimen/_17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/_12dp"
                    android:background="#DDDDDD" />

                <include
                    android:id="@+id/amounts"
                    layout="@layout/item_confirmation_amounts" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_marginTop="@dimen/_18dp"
            android:fontFamily="@font/mont_semibold"
            android:text="@string/confirm"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_17sp"
            app:backgroundTint="#E62324"
            app:cornerRadius="@dimen/_12dp"
            app:layout_constraintTop_toBottomOf="@id/details_card" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_marginTop="@dimen/_10dp"
            android:fontFamily="@font/mont_semibold"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="#E62324"
            android:textSize="@dimen/_16sp"
            app:backgroundTint="@color/white"
            app:cornerRadius="@dimen/_12dp"
            app:layout_constraintTop_toBottomOf="@id/confirm_btn"
            app:strokeColor="#E62324"
            app:strokeWidth="1dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
