<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/theme_screen_background"
    tools:context=".screens.transfer.recipient.TransferRecipientFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="@dimen/_68dp"
        android:background="@color/card_bg"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_btn"
            android:layout_width="@dimen/_48dp"
            android:layout_height="@dimen/_48dp"
            android:layout_marginStart="@dimen/_10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="@dimen/_12dp"
            android:src="@drawable/arrow_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_18dp"
            android:fontFamily="@font/mont_bold"
            android:text="@string/new_transfer"
            android:textColor="@color/title"
            android:textSize="@dimen/_22sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/back_btn"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/recipient_input_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/_76dp"
        android:layout_marginHorizontal="@dimen/_16dp"
        android:layout_marginTop="@dimen/_20dp"
        android:background="@drawable/recipient_input_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_16dp"
        android:paddingEnd="@dimen/_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/recipient_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/mont_semibold"
            android:hint="@string/recipient_input_hint"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="@color/title"
            android:textColorHint="@color/subtitle"
            android:textSize="@dimen/_14sp" />

        <ImageButton
            android:id="@+id/qr_btn"
            android:layout_width="@dimen/_46dp"
            android:layout_height="@dimen/_46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/scan_qr"
            android:padding="@dimen/_10dp"
            android:src="@drawable/ic_qr_scan"
            app:tint="#A41D26" />

        <ImageButton
            android:id="@+id/continue_btn"
            android:layout_width="@dimen/_46dp"
            android:layout_height="@dimen/_46dp"
            android:background="@drawable/recipient_continue_background"
            android:contentDescription="@string/continue_title"
            android:padding="@dimen/_15dp"
            android:src="@drawable/right_red_arrow" />
    </LinearLayout>

    <TextView
        android:id="@+id/contacts_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20dp"
        android:layout_marginTop="@dimen/_24dp"
        android:fontFamily="@font/mont_bold"
        android:text="@string/all_contacts"
        android:textColor="@color/title"
        android:textSize="@dimen/_18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recipient_input_container" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contacts_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contacts_title"
        tools:listitem="@layout/item_transfer_recipient" />

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_28dp"
        android:fontFamily="@font/mont_regular"
        android:gravity="center"
        android:text="@string/payment_contacts_empty"
        android:textColor="@color/subtitle"
        android:textSize="@dimen/_13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contacts_title" />
</androidx.constraintlayout.widget.ConstraintLayout>
