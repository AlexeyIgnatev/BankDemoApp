<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B090C"
    tools:context=".screens.wallet.WalletFragment">

    <com.esom.bank.common.utils.views.AnimatedAtmosphereBackgroundView
        android:id="@+id/gradient_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/home_atmosphere_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/main_bottom_light_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.58"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_72dp"
        android:paddingBottom="@dimen/_10dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/profile_btn"
            android:layout_width="@dimen/_46dp"
            android:layout_height="@dimen/_46dp"
            android:layout_marginStart="@dimen/_18dp"
            android:layout_marginTop="@dimen/_10dp"
            android:background="@drawable/home_header_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="@dimen/_22dp"
                android:layout_height="@dimen/_22dp"
                android:layout_gravity="center"
                android:src="@drawable/profile_icon"
                app:tint="@color/white" />
        </FrameLayout>

        <ImageView
            android:id="@+id/bank_logo"
            android:layout_width="@dimen/_128dp"
            android:layout_height="@dimen/_50dp"
            android:background="@drawable/home_bank_logo_background"
            android:paddingHorizontal="@dimen/_8dp"
            android:paddingVertical="@dimen/_6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fcb_main_logo_compact"
            app:layout_constraintBottom_toBottomOf="@id/profile_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/profile_btn" />

        <FrameLayout
            android:id="@+id/qr_btn"
            android:layout_width="@dimen/_46dp"
            android:layout_height="@dimen/_46dp"
            android:layout_marginEnd="@dimen/_18dp"
            android:background="@drawable/home_header_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/profile_btn">
            <ImageView
                android:layout_width="@dimen/_22dp"
                android:layout_height="@dimen/_22dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:src="@drawable/ic_bottom_support"
                app:tint="@color/white" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/notification_btn"
            android:layout_width="@dimen/_46dp"
            android:layout_height="@dimen/_46dp"
            android:layout_marginEnd="@dimen/_8dp"
            android:background="@drawable/home_header_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toStartOf="@id/qr_btn"
            app:layout_constraintTop_toTopOf="@id/profile_btn">
            <ImageView
                android:id="@+id/notification_icon"
                android:layout_width="@dimen/_21dp"
                android:layout_height="@dimen/_21dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:src="@drawable/notification_icon"
                app:tint="@color/white" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/_28dp">

                <LinearLayout
                    android:id="@+id/wallets_header"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_44dp"
                    android:layout_marginStart="@dimen/_18dp"
                    android:layout_marginTop="@dimen/_46dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mont_bold"
                        android:text="@string/wallets_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_24sp" />
                    <ImageView
                        android:layout_width="@dimen/_17dp"
                        android:layout_height="@dimen/_17dp"
                        android:layout_marginStart="@dimen/_8dp"
                        android:rotation="-90"
                        android:scaleType="centerInside"
                        android:src="@drawable/arrow_bottom"
                        android:translationY="@dimen/_2dp"
                        app:tint="@color/white" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/security_btn"
                    android:layout_width="@dimen/_38dp"
                    android:layout_height="@dimen/_38dp"
                    android:layout_marginEnd="@dimen/_18dp"
                    android:background="@drawable/home_header_button"
                    app:layout_constraintBottom_toBottomOf="@id/wallets_header"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/wallets_header">
                    <ImageView
                        android:layout_width="@dimen/_20dp"
                        android:layout_height="@dimen/_20dp"
                        android:layout_gravity="center"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_security_home"
                        app:tint="@color/white" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/eye_btn"
                    android:layout_width="@dimen/_38dp"
                    android:layout_height="@dimen/_38dp"
                    android:layout_marginEnd="@dimen/_8dp"
                    android:background="@drawable/home_header_button"
                    android:padding="@dimen/_9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_eye_open"
                    app:layout_constraintBottom_toBottomOf="@id/wallets_header"
                    app:layout_constraintEnd_toStartOf="@id/security_btn"
                    app:layout_constraintTop_toTopOf="@id/wallets_header"
                    app:tint="@color/white" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pager"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_190dp"
                    android:layout_marginTop="@dimen/_8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/wallets_header"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_home_wallet" />

                <TextView
                    android:id="@+id/empty_wallets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mont_semibold"
                    android:text="@string/no_wallets"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/pager"
                    app:layout_constraintEnd_toEndOf="@id/pager"
                    app:layout_constraintStart_toStartOf="@id/pager"
                    app:layout_constraintTop_toTopOf="@id/pager" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/history_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_18dp"
                    android:layout_marginTop="@dimen/_20dp"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="@dimen/_24dp"
                    app:cardElevation="@dimen/_0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/pager"
                    app:strokeWidth="@dimen/_0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_18dp"
                        android:paddingVertical="@dimen/_14dp">

                        <LinearLayout
                            android:id="@+id/history_header"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_42dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mont_bold"
                                android:text="@string/history"
                                android:textColor="@color/title"
                                android:textSize="@dimen/_23sp" />
                            <ImageView
                                android:id="@+id/history_arrow"
                                android:layout_width="@dimen/_17dp"
                                android:layout_height="@dimen/_17dp"
                                android:layout_marginStart="@dimen/_7dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/arrow_bottom_gray" />
                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/all_history_btn"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/_8dp"
                                android:text="@string/home_all_operations"
                                android:textColor="@color/red"
                                android:textSize="@dimen/_14sp" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/history_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/transactions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:itemCount="4"
                                tools:listitem="@layout/item_transaction" />
                            <TextView
                                android:id="@+id/empty_history"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_80dp"
                                android:fontFamily="@font/mont_regular"
                                android:gravity="center"
                                android:text="@string/no_operations"
                                android:textColor="@color/subtitle"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/exchange_rates_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12dp"
                    android:layout_marginTop="@dimen/_16dp"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="@dimen/_24dp"
                    app:cardElevation="@dimen/_0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/history_card"
                    app:strokeWidth="@dimen/_0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/_17dp"
                        android:paddingBottom="@dimen/_18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_18dp"
                            android:fontFamily="@font/mont_bold"
                            android:text="@string/home_exchange_rates"
                            android:textColor="@color/title"
                            android:textSize="@dimen/_23sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_18dp"
                            android:layout_marginTop="@dimen/_2dp"
                            android:fontFamily="@font/mont_regular"
                            android:text="@string/home_exchange_rates_subtitle"
                            android:textColor="@color/subtitle"
                            android:textSize="@dimen/_11sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/exchange_rates"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_142dp"
                            android:layout_marginTop="@dimen/_13dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="horizontal"
                            android:overScrollMode="never"
                            android:paddingStart="@dimen/_18dp"
                            android:paddingEnd="@dimen/_18dp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_home_exchange_rate" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
