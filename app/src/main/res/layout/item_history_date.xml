<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_20dp"
    tools:ignore="MissingConstraints">

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10dp"
        android:fontFamily="@font/mont_bold"
        android:letterSpacing="-0.01"
        android:text="Сегодня"
        android:textColor="#1D1D1B"
        android:textSize="@dimen/_16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/sum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="-423 232"
        android:fontFamily="@font/mont_medium"
        android:textSize="@dimen/_16sp"
        android:textColor="#B2B2B2"
        android:letterSpacing="-0.01"
        app:layout_constraintEnd_toStartOf="@id/som_icon"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="@dimen/_2dp"/>
    <ImageView
        android:id="@+id/som_icon"
        android:layout_width="@dimen/_7dp"
        android:layout_height="@dimen/_10dp"
        app:tint="#B2B2B2"
        android:src="@drawable/som_title_icon"
        app:layout_constraintTop_toTopOf="@id/sum"
        app:layout_constraintBottom_toBottomOf="@id/sum"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_3dp"
        android:layout_marginEnd="@dimen/_10dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>