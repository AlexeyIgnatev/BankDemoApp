<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_10dp"
    tools:ignore="MissingConstraints">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/_261dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@drawable/currency_background"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Оператор Алия"
            android:textColor="#E62324"
            android:letterSpacing="-0.01"
            android:textSize="@dimen/_15sp"
            android:fontFamily="@font/mont_bold"/>
        <TextView
            android:id="@+id/message"
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:text="Сайт рыбатекст поможет дизайнеру, верстальщику, вебмастеру сгенерировать несколько абзацев более менее осмысленного текста рыбы на русском языке, а начинающему оратору отточить навык публичных выступлений в домашних условиях"
            android:fontFamily="@font/mont_regular"
            android:letterSpacing="-0.01"
            android:textSize="@dimen/_14sp"
            android:textColor="@color/title"
            app:layout_constraintTop_toBottomOf="@id/name"
            android:layout_marginTop="@dimen/_5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20:21"
            android:textColor="@color/subtitle"
            android:textSize="@dimen/_11sp"
            android:letterSpacing="-0.01"
            android:fontFamily="@font/mont_bold"
            app:layout_constraintTop_toBottomOf="@id/message"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_5dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
