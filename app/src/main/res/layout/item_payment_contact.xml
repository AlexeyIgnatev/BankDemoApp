<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/_86dp"
    android:layout_height="@dimen/_108dp"
    android:layout_marginEnd="@dimen/_10dp"
    android:background="@drawable/payment_contact_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_8dp"
    android:paddingTop="@dimen/_10dp">

    <TextView
        android:id="@+id/avatar"
        android:layout_width="@dimen/_42dp"
        android:layout_height="@dimen/_42dp"
        android:background="@drawable/payment_contact_avatar"
        android:fontFamily="@font/mont_bold"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/_13sp" />

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:ellipsize="end"
        android:fontFamily="@font/mont_semibold"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/title"
        android:textSize="@dimen/_10sp" />
</LinearLayout>
