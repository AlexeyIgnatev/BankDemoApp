<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <action
        android:id="@+id/startMainFragment"
        app:destination="@id/mainFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out" />

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.esom.bank.screens.main.MainFragment"
        android:label="fragment_main"
        tools:layout="@layout/fragment_main" />

    <action
        android:id="@+id/startQrFragment"
        app:destination="@id/qrFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out" />

    <fragment
        android:id="@+id/qrFragment"
        android:name="com.esom.bank.screens.qr.QrFragment"
        android:label="fragment_qr"
        tools:layout="@layout/fragment_qr" />

    <action
        android:id="@+id/startSwapFragment"
        app:destination="@id/swapFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out" />

    <fragment
        android:id="@+id/swapFragment"
        android:name="com.esom.bank.screens.swap.SwapFragment"
        android:label="fragment_swap"
        tools:layout="@layout/fragment_swap">
        <argument
            android:name="from"
            app:argType="string" />
        <argument
            android:name="to"
            app:argType="string" />
    </fragment>

    <action
        android:id="@+id/startTransferFragment"
        app:destination="@id/transferFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out" />

    <action
        android:id="@+id/startTransferRecipientFragment"
        app:destination="@id/transferRecipientFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out" />

    <fragment
        android:id="@+id/transferRecipientFragment"
        android:name="com.esom.bank.screens.transfer.recipient.TransferRecipientFragment"
        android:label="fragment_transfer_recipient"
        tools:layout="@layout/fragment_transfer_recipient">
        <argument
            android:name="currency"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/transferFragment"
        android:name="com.esom.bank.screens.transfer.TransferFragment"
        android:label="fragment_transfer"
        tools:layout="@layout/fragment_transfer">
        <argument
            android:name="currency"
            app:argType="string"/>
        <argument
            android:name="contact"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="recipientName"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <action
        android:id="@+id/startReceiveFragment"
        app:destination="@id/receiveFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out" />

    <fragment
        android:id="@+id/receiveFragment"
        android:name="com.esom.bank.screens.receive.ReceiveFragment"
        android:label="fragment_receive"
        tools:layout="@layout/fragment_receive">
        <argument
            android:name="contact"
            app:argType="string"/>
        <argument
            android:name="currency"
            app:argType="string"/>
    </fragment>

    <action
        android:id="@+id/startAuthFragment"
        app:destination="@id/authFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/authFragment"
        android:name="com.esom.bank.screens.auth.AuthFragment"
        android:label="fragment_auth"
        tools:layout="@layout/fragment_auth" />

    <fragment
        android:id="@+id/pinCreateFragment"
        android:name="com.esom.bank.screens.pinCreate.PinCreateFragment"
        tools:layout="@layout/fragment_pin_create">
        <argument
            android:name="fromSettings"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>
    <action
        android:id="@+id/startPinCreateFragment"
        app:destination="@id/pinCreateFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out" />

    <fragment
        android:id="@+id/logInFragment"
        android:name="com.esom.bank.screens.login.LogInFragment"
        tools:layout="@layout/fragment_log_in"/>
    <action
        android:id="@+id/startLogInFragment"
        app:destination="@id/logInFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out"/>

    <fragment
        android:id="@+id/bioFragment"
        android:name="com.esom.bank.screens.bio.BioFragment"
        tools:layout="@layout/fragment_bio"/>
    <action
        android:id="@+id/startBioFragment"
        app:destination="@id/bioFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out"/>

    <dialog
        android:id="@+id/chooseDateFragment"
        android:name="com.esom.bank.screens.history.dialog.choosedate.ChooseDateFragment"
        tools:layout="@layout/fragment_choose_date"/>
    <action
        android:id="@+id/startChooseDateFragment"
        app:destination="@id/chooseDateFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out" />

    <fragment
        android:id="@+id/successTransferFragment"
        android:name="com.esom.bank.screens.transfer.dialog.success.SuccessTransferFragment"
        tools:layout="@layout/fragment_success_transfer"/>
    <action
        android:id="@+id/startSuccessTransferFragment"
        app:destination="@id/successTransferFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out"/>

    <dialog
        android:id="@+id/failTransferFragment"
        android:name="com.esom.bank.screens.transfer.dialog.fail.FailTransferFragment"
        tools:layout="@layout/fragment_fail_transfer">
        <argument
            android:name="error"
            app:argType="string"/>
    </dialog>
    <action
        android:id="@+id/startFailTransferFragment"
        app:destination="@id/failTransferFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out"/>

    <dialog
        android:id="@+id/choosePeriodFragment"
        android:name="com.esom.bank.screens.history.dialog.chooseperiod.ChoosePeriodFragment"
        tools:layout="@layout/fragment_choose_period"/>
    <action
        android:id="@+id/startChoosePeriodFragment"
        app:destination="@id/choosePeriodFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out"/>

    <dialog
        android:id="@+id/chooseActiveFragment"
        android:name="com.esom.bank.screens.history.dialog.chooseactive.ChooseActiveFragment"
        tools:layout="@layout/fragment_choose_active"/>
    <action
        android:id="@+id/startChooseActiveFragment"
        app:destination="@id/chooseActiveFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out"/>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.esom.bank.screens.chat.ChatFragment"
        tools:layout="@layout/fragment_chat"/>
    <action
        android:id="@+id/startChatFragment"
        app:destination="@id/chatFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out"/>
    <dialog
        android:id="@+id/transferConfirmationFragment"
        android:name="com.esom.bank.screens.main.dialog.TransferConfirmationFragment"
        tools:layout="@layout/fragment_transfer_confirmation" />
    <action
        android:id="@+id/startTransferConfirmationFragment"
        app:destination="@id/transferConfirmationFragment"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/fade_out" />
</navigation>
