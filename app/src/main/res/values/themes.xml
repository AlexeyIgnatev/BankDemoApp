<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.BankDemoApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/red</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
    </style>

    <style name="Theme.BankDemoApp" parent="Base.Theme.BankDemoApp" />

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="@style/ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetDialog</item>
    </style>

    <style name="BottomSheetDialog" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="DayHeader">
        <item name="textAllCaps">true</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">@dimen/_32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#1D1D1B</item>
        <item name="android:textSize">@dimen/_16sp</item>
    </style>

    <style name="SuccessDetailsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/mont_medium</item>
        <item name="android:textColor">@color/subtitle</item>
        <item name="android:textSize">@dimen/_15sp</item>
    </style>

    <style name="SuccessDetailsValue">
        <item name="android:layout_width">@dimen/_0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">start</item>
        <item name="android:fontFamily">@font/mont_medium</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/edittext_title</item>
        <item name="android:textSize">@dimen/_16sp</item>
    </style>

    <style name="SecurityCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
    </style>
    <style name="SecurityTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fontFamily">@font/mont_semibold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:textColor">@color/title</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="LockKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/lock_key_height</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">@dimen/lock_key_margin</item>
        <item name="android:background">@drawable/lock_key_background</item>
        <item name="android:fontFamily">@font/mont_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:lines">1</item>
        <item name="android:textColor">@color/title</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="LockKeySpace">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/lock_key_height</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">@dimen/lock_key_margin</item>
    </style>

    <style name="HistoryFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/gray_period_background</item>
        <item name="android:fontFamily">@font/mont_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:drawableEnd">@drawable/history_filter_arrow</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:minWidth">128dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:textColor">@color/title</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
